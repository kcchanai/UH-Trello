rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verifiedEmail() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }
    function workspaceDoc(workspaceId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId);
    }
    function memberDoc(workspaceId, uid) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(uid);
    }
    function currentMemberDoc(workspaceId) {
      return memberDoc(workspaceId, request.auth.uid);
    }
    function member(workspaceId) { return get(currentMemberDoc(workspaceId)).data; }
    function isMember(workspaceId) { return signedIn() && exists(currentMemberDoc(workspaceId)); }
    function isOwner(workspaceId) { return isMember(workspaceId) && member(workspaceId).role == 'owner'; }
    function canEdit(workspaceId) {
      return isMember(workspaceId) && member(workspaceId).role in ['owner', 'editor'];
    }
    function validRole(role) { return role in ['owner', 'editor', 'viewer']; }
    function invitePath(workspaceId, inviteId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/invites/$(inviteId);
    }
    function inviteDoc(workspaceId, inviteId) { return get(invitePath(workspaceId, inviteId)).data; }
    function validInviteShape(data) {
      return data.keys().hasAll(['emailLower', 'role', 'createdBy', 'createdAt', 'expiresAt', 'revokedAt', 'acceptedAt', 'acceptedBy'])
        && data.keys().hasOnly(['emailLower', 'role', 'createdBy', 'createdAt', 'expiresAt', 'revokedAt', 'acceptedAt', 'acceptedBy'])
        && data.emailLower is string
        && data.emailLower.size() > 2
        && data.emailLower.size() <= 320
        && data.role in ['editor', 'viewer']
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time
        && data.expiresAt > request.time
        && data.expiresAt <= request.time + duration.value(7, 'd')
        && data.revokedAt == null
        && data.acceptedAt == null
        && data.acceptedBy == null;
    }
    function activeInviteForCurrentUser(data) {
      return verifiedEmail()
        && request.auth.token.email == data.emailLower
        && data.acceptedAt == null
        && data.acceptedBy == null
        && data.revokedAt == null
        && data.expiresAt > request.time;
    }
    function validInviteMembershipCreate(workspaceId, uid) {
      let inviteId = request.resource.data.inviteId;
      let invite = inviteDoc(workspaceId, inviteId);
      let accepted = getAfter(invitePath(workspaceId, inviteId)).data;
      return request.resource.data.keys().hasAll(['uid', 'role', 'emailLower', 'inviteId'])
        && request.resource.data.uid == uid
        && uid == request.auth.uid
        && activeInviteForCurrentUser(invite)
        && request.resource.data.role == invite.role
        && request.resource.data.emailLower == invite.emailLower
        && accepted.acceptedAt == request.time
        && accepted.acceptedBy == request.auth.uid;
    }
    function validInviteAcceptance(workspaceId, inviteId) {
      let invite = resource.data;
      let joinedMember = getAfter(memberDoc(workspaceId, request.auth.uid)).data;
      let profileAfter = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return activeInviteForCurrentUser(invite)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptedAt', 'acceptedBy'])
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.acceptedBy == request.auth.uid
        && joinedMember.uid == request.auth.uid
        && joinedMember.role == invite.role
        && joinedMember.emailLower == invite.emailLower
        && joinedMember.inviteId == inviteId
        && profileAfter.workspaceIds is list
        && profileAfter.workspaceIds.hasAll([workspaceId]);
    }
    function validOwnershipTransfer(workspaceId) {
      let previousOwner = resource.data.ownerUid;
      let nextOwner = request.resource.data.ownerUid;
      let oldOwnerAfter = getAfter(memberDoc(workspaceId, previousOwner)).data;
      let newOwnerBefore = get(memberDoc(workspaceId, nextOwner)).data;
      let newOwnerAfter = getAfter(memberDoc(workspaceId, nextOwner)).data;
      return isOwner(workspaceId)
        && previousOwner == request.auth.uid
        && nextOwner != previousOwner
        && newOwnerBefore.role in ['editor', 'viewer']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid', 'updatedAt'])
        && oldOwnerAfter.uid == previousOwner
        && oldOwnerAfter.role in ['editor', 'viewer']
        && newOwnerAfter.uid == nextOwner
        && newOwnerAfter.role == 'owner';
    }
    function validTransferredMemberUpdate(workspaceId, uid) {
      let workspaceAfter = getAfter(workspaceDoc(workspaceId)).data;
      let previousOwner = get(workspaceDoc(workspaceId)).data.ownerUid;
      return isOwner(workspaceId)
        && previousOwner == request.auth.uid
        && workspaceAfter.ownerUid != previousOwner
        && (
          (uid == previousOwner
            && resource.data.role == 'owner'
            && request.resource.data.uid == uid
            && request.resource.data.role in ['editor', 'viewer'])
          || (uid == workspaceAfter.ownerUid
            && resource.data.role in ['editor', 'viewer']
            && request.resource.data.uid == uid
            && request.resource.data.role == 'owner')
        );
    }

    function validSelfLeave(workspaceId, uid) {
      let profileAfter = getAfter(/databases/$(database)/documents/users/$(uid)).data;
      return uid == request.auth.uid
        && resource.data.role != 'owner'
        && profileAfter.workspaceIds is list
        && !profileAfter.workspaceIds.hasAll([workspaceId]);
    }

    function validRevision() {
      let prior = resource.data.keys().hasAll(['revision']) ? resource.data.revision : -1;
      return request.resource.data.revision == prior + 1
        && request.resource.data.clientMutationId is string
        && request.resource.data.clientMutationId.size() >= 16
        && request.resource.data.clientMutationId.size() <= 128;
    }
    function validInitialRevision() {
      return request.resource.data.revision == 0
        && request.resource.data.clientMutationId is string
        && request.resource.data.clientMutationId.size() >= 16
        && request.resource.data.clientMutationId.size() <= 128;
    }

    function validActivity(data, activityId) {
      return data.keys().hasAll(['actorUid', 'action', 'boardId', 'clientMutationId', 'createdAt'])
        && data.keys().hasOnly(['actorUid', 'action', 'boardId', 'clientMutationId', 'createdAt'])
        && data.actorUid == request.auth.uid
        && data.action in ['board-created', 'board-updated', 'card-created', 'card-updated', 'card-moved', 'list-created', 'list-updated', 'workspace-updated']
        && data.boardId is string
        && data.boardId.size() <= 128
        && data.clientMutationId is string
        && data.clientMutationId == activityId
        && data.clientMutationId.size() >= 16
        && data.clientMutationId.size() <= 128
        && data.createdAt == request.time;
    }

    match /users/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /workspaces/{workspaceId} {
      allow read: if isMember(workspaceId);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && getAfter(memberDoc(workspaceId, request.auth.uid)).data.uid == request.auth.uid
        && getAfter(memberDoc(workspaceId, request.auth.uid)).data.role == 'owner';
      allow update: if isOwner(workspaceId) && (
        request.resource.data.ownerUid == resource.data.ownerUid || validOwnershipTransfer(workspaceId)
      );
      allow delete: if isOwner(workspaceId);

      match /members/{uid} {
        allow read: if isMember(workspaceId);
        allow create: if signedIn()
          && request.resource.data.uid == uid
          && validRole(request.resource.data.role)
          && (
            (uid == request.auth.uid
              && request.resource.data.role == 'owner'
              && getAfter(workspaceDoc(workspaceId)).data.ownerUid == uid)
            || (isOwner(workspaceId) && request.resource.data.role in ['editor', 'viewer'])
            || (uid == request.auth.uid && validInviteMembershipCreate(workspaceId, uid))
          );
        allow update: if validTransferredMemberUpdate(workspaceId, uid) || (
          isOwner(workspaceId)
          && resource.data.role in ['editor', 'viewer']
          && request.resource.data.uid == uid
          && request.resource.data.emailLower == resource.data.emailLower
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['editor', 'viewer']
        );
        allow delete: if validSelfLeave(workspaceId, uid)
          || (isOwner(workspaceId) && resource.data.role != 'owner');
      }

      match /invites/{inviteId} {
        allow read: if isOwner(workspaceId) || activeInviteForCurrentUser(resource.data);
        allow create: if isOwner(workspaceId) && validInviteShape(request.resource.data);
        allow update: if (isOwner(workspaceId)
          && resource.data.revokedAt == null
          && resource.data.acceptedAt == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revokedAt'])
          && request.resource.data.revokedAt == request.time)
          || validInviteAcceptance(workspaceId, inviteId);
        allow delete: if false;
      }

      match /boards/{boardId} {
        allow read: if isMember(workspaceId);
        allow create: if canEdit(workspaceId) && validInitialRevision();
        allow update: if canEdit(workspaceId) && validRevision();
        allow delete: if canEdit(workspaceId);
        match /lists/{listId} {
          allow read: if isMember(workspaceId);
          allow create: if canEdit(workspaceId) && validInitialRevision();
          allow update: if canEdit(workspaceId) && validRevision();
          allow delete: if canEdit(workspaceId);
        }
        match /cards/{cardId} {
          allow read: if isMember(workspaceId);
          allow create: if canEdit(workspaceId) && validInitialRevision();
          allow update: if canEdit(workspaceId) && validRevision();
          allow delete: if canEdit(workspaceId);
        }
      }

      match /activity/{activityId} {
        allow read: if isMember(workspaceId);
        allow create: if canEdit(workspaceId) && validActivity(request.resource.data, activityId);
        allow update, delete: if false;
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
