# Public Firebase Web App configuration. These values identify the browser client;
# authorization is enforced by Firebase Authentication and Firestore Security Rules.
# Never add service-account JSON, private keys, OAuth client secrets, or admin SDK credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
